# Korinnia configuration. Copy to .env and adjust. All settings are environment variables.

# --- General ----------------------------------------------------------------------
# development | production   (OpenAPI docs at /api/docs are disabled in production)
ENVIRONMENT=development
LOG_LEVEL=INFO
# Secret used to sign tokens. Generate with:  openssl rand -hex 32
SECRET_KEY=dev-only-insecure-secret-change-me

# --- Database (PostgreSQL 16) -----------------------------------------------------------
POSTGRES_USER=korinnia
POSTGRES_PASSWORD=korinnia-dev-password
POSTGRES_DB=korinnia

# Public URL of the app (used in invitation / password-reset links)
PUBLIC_BASE_URL=http://localhost:8080
# Auth cookies get the Secure flag (HTTPS only). Keep true in production behind TLS;
# false only for plain-HTTP local development.
COOKIE_SECURE=false

# --- First superadmin -----------------------------------------------------------------
# Created on first start if no superadmin exists yet (min. 10 characters). Changing these
# later has no effect — manage users in the app, or use `python -m app.cli` (see README).
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me-now-please

# --- Demo family -------------------------------------------------------------------
# Every new account gets its own editable copy of a fictional demo family (25 people with
# biographies and illustrated portraits) to explore and practise on. Users can delete it.
DEMO_TREE_FOR_NEW_USERS=true

# --- Uploads ------------------------------------------------------------------------
# Max size of a single upload in MB (large videos/audio recordings allowed)
MAX_UPLOAD_SIZE_MB=2048

# --- Background worker ----------------------------------------------------------------
WORKER_CONCURRENCY=2

# --- Web server ------------------------------------------------------------------------
# nginx serves plain HTTP; terminate TLS at your ingress / load balancer.
# Host port nginx is published on (8080 in development; e.g. 80 in production).
HTTP_PORT=8080
