# Korinnia configuration. Copy to .env and adjust. All settings are environment variables.

# --- General ----------------------------------------------------------------------
# development | production   (OpenAPI docs at /api/docs are disabled in production)
ENVIRONMENT=development
LOG_LEVEL=INFO
# Secret used to sign tokens. Generate with:  openssl rand -hex 32
SECRET_KEY=dev-only-insecure-secret-change-me

# --- Database (PostgreSQL 16) -----------------------------------------------------------
POSTGRES_USER=korinnia
POSTGRES_PASSWORD=korinnia-dev-password
POSTGRES_DB=korinnia

# --- First superadmin (created on first start; phase 2) ---------------------------------
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me-now

# --- Uploads ------------------------------------------------------------------------
# Max size of a single upload in MB (large videos/audio recordings allowed)
MAX_UPLOAD_SIZE_MB=2048

# --- Background worker ----------------------------------------------------------------
WORKER_CONCURRENCY=2

# --- Web server ------------------------------------------------------------------------
# nginx serves plain HTTP; terminate TLS at your ingress / load balancer.
# Host port nginx is published on (8080 in development; e.g. 80 in production).
HTTP_PORT=8080
